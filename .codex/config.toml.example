# Codex project example configuration
# Copy and adapt into:
# - ~/.codex/config.toml for user-level defaults
# - .codex/config.toml for project-scoped defaults

model = "gpt-5.4"
model_reasoning_effort = "high"
web_search = "cached"
log_dir = "./.codex-log"

[shell_environment_policy]
inherit = "core"
ignore_default_excludes = false
include_only = ["PATH", "HOME", "PYTHONPATH", "VIRTUAL_ENV", "NODE_OPTIONS", "PNPM_HOME"]
exclude = ["AWS_*", "AZURE_*", "GOOGLE_*", "*TOKEN*", "*SECRET*", "*KEY*"]

[otel]
environment = "dev"
exporter = "none"
log_user_prompt = false

[profiles.readonly_quiet]
approval_policy = "never"
sandbox_mode = "read-only"
web_search = "disabled"

[profiles.build_local]
approval_policy = "on-request"
sandbox_mode = "workspace-write"
web_search = "cached"

[profiles.build_local.sandbox_workspace_write]
network_access = false

[profiles.research_live]
approval_policy = "on-request"
sandbox_mode = "workspace-write"
web_search = "live"

[profiles.research_live.sandbox_workspace_write]
network_access = true

[profiles.ci_validate]
approval_policy = "never"
sandbox_mode = "read-only"
web_search = "disabled"

# Enable or disable repo skills explicitly if needed:
# [[skills.config]]
# path = ".agents/skills/research-evidence/SKILL.md"
# enabled = true
